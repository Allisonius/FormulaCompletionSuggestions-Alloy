{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Alloy",
  "scopeName": "source.alloy",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#module-declaration"
    },
    {
      "include": "#import-declaration"
    },
    {
      "include": "#signature-declaration"
    },
    {
      "include": "#fact-declaration"
    },
    {
      "include": "#predicate-declaration"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#assert-declaration"
    },
    {
      "include": "#command-declaration"
    },
    {
      "include": "#quantifiers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#temporal-operators"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.alloy",
          "match": "//.*$"
        },
        {
          "name": "comment.block.alloy",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.alloy",
          "match": "\\b(module|open|sig|fact|pred|fun|assert|run|check|for|but|exactly|let|in|extends|this|disj|var|as)\\b"
        }
      ]
    },
    "module-declaration": {
      "match": "\\b(module)\\s+([A-Za-z][A-Za-z0-9_]*(?:/[A-Za-z][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.control.alloy" },
        "2": { "name": "entity.name.namespace.alloy" }
      }
    },
    "import-declaration": {
      "match": "\\b(open)\\s+([A-Za-z][A-Za-z0-9_]*(?:/[A-Za-z][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.control.alloy" },
        "2": { "name": "entity.name.namespace.alloy" }
      }
    },
    "signature-declaration": {
      "begin": "\\b(var)?\\s*(abstract)?\\s*(lone|some|one)?\\s*(sig)\\s+([A-Za-z][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z][A-Za-z0-9_]*)*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.alloy" },
        "2": { "name": "storage.modifier.alloy" },
        "3": { "name": "storage.modifier.alloy" },
        "4": { "name": "keyword.control.alloy" },
        "5": { "name": "entity.name.type.alloy" }
      },
      "end": "\\}",
      "patterns": [
        {
          "match": "\\b(extends|in)\\b",
          "name": "keyword.control.alloy"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "fact-declaration": {
      "begin": "\\b(fact)\\s+([A-Za-z][A-Za-z0-9_]*)?",
      "beginCaptures": {
        "1": { "name": "keyword.control.alloy" },
        "2": { "name": "entity.name.function.alloy" }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "predicate-declaration": {
      "begin": "\\b(pred)\\s+((?:[A-Za-z][A-Za-z0-9_]*\\.)?[A-Za-z][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.alloy" },
        "2": { "name": "entity.name.function.alloy" }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "function-declaration": {
      "begin": "\\b(fun)\\s+((?:[A-Za-z][A-Za-z0-9_]*\\.)?[A-Za-z][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.alloy" },
        "2": { "name": "entity.name.function.alloy" }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "assert-declaration": {
      "begin": "\\b(assert)\\s+([A-Za-z][A-Za-z0-9_]*)?",
      "beginCaptures": {
        "1": { "name": "keyword.control.alloy" },
        "2": { "name": "entity.name.function.alloy" }
      },
      "end": "\\}",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "command-declaration": {
      "begin": "\\b(?:([A-Za-z][A-Za-z0-9_]*)\\s*:\\s*)?(run|check)\\b",
      "beginCaptures": {
        "1": { "name": "entity.name.function.alloy" },
        "2": { "name": "keyword.control.alloy" }
      },
      "end": "$",
      "patterns": [
        {
          "match": "\\b(for)\\s+(\\d+)\\b",
          "captures": {
            "1": { "name": "keyword.control.alloy" },
            "2": { "name": "constant.numeric.alloy" }
          }
        },
        {
          "match": "\\b(exactly)\\s+(\\d+)\\s+([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.alloy" },
            "2": { "name": "constant.numeric.alloy" },
            "3": { "name": "entity.name.type.alloy" }
          }
        },
        {
          "include": "#comments"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "quantifiers": {
      "match": "\\b(all|no|some|lone|one|sum)\\b",
      "name": "keyword.other.quantifier.alloy"
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(none|univ|iden)\\b",
          "name": "constant.language.alloy"
        },
        {
          "match": "-?\\b\\d+\\b",
          "name": "constant.numeric.alloy"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(\\-\\>|\\+\\+|<:|:>)",
          "name": "keyword.operator.special.alloy"
        },
        {
          "match": "(\\+|-|\\*|&|\\||!|~|\\^|=>|<==>|=|<|>|=<|>=|:|::|\\.|,|;|\\{|\\}|\\(|\\)|\\[|\\]|@)",
          "name": "keyword.operator.alloy"
        },
        {
          "match": "\\b(in|not|and|or|iff|implies|else)\\b",
          "name": "keyword.operator.word.alloy"
        }
      ]
    },
    "temporal-operators": {
      "match": "\\b(always|eventually|after|before|historically|once|until|releases|since|triggered)\\b",
      "name": "keyword.other.temporal.alloy"
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#quantifiers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#temporal-operators"
        },
        {
          "match": "\\b[A-Za-z][A-Za-z0-9_]*\\b",
          "name": "variable.other.alloy"
        }
      ]
    }
  }
}
